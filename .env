# Base URLs for the two Kopa backend microservices this app talks to directly.
#
# iOS simulator can reach the host machine via plain "localhost" (defaults below work as-is).
# Android emulator needs 10.0.2.2 instead of localhost.
# A physical device needs your dev machine's real LAN IP (e.g. http://192.168.1.23:8083/...),
# since "localhost" on a phone means the phone itself.
EXPO_PUBLIC_IDENTITY_API_BASE_URL=http://localhost:8083/kopa-customer-identity
EXPO_PUBLIC_SELFCARE_API_BASE_URL=http://localhost:8081/kopa-customer-self-care
